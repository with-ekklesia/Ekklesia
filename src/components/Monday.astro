---
import GroupHeader from "./Monday/GroupHeader.astro";
import RowHeader from "./Monday/RowHeader.astro";

const colors = [255, 203, 0];


---
<div class="group-header-wrapper resize-group-header-wrapper board-id-1819986031 with-group-borders group-header-wrapper--sticky" style="top: 176px; height: 76px; display: block;">
   <div id="row-header-currentBoard-1819986031-1819986031_topics-notfloating" class="group-header-component-wrapper groupHeaderComponentWrapper--e+oIF">
      <div class="group-header-component-title-row" style="max-width: 695px;">
         <div class="grid-floating-cells-row-component seperated-footer with-group-borders sticky-feature">
            <div class="grid-floating-cell-pulse-menu col-identifier-pulse-menu without-subitem-line">
               <div class="grid-pulse-menu-component">
                  <div class="grid-pulse-menu-component-inner">
                     <div class="group-menu group-menu--three-dots-style">
                        <div class="ds-menu-button-container">
                           <div id="menuButton_4" data-testid="clickable_menuButton_4" tabindex="0" role="button" aria-label="Options" aria-haspopup="true" aria-expanded="false" class="clickable_1f03c608c2 disableTextSelection_4036d2f679"><a class="three-dots-group-menu-button fa icon ellipsis icon-v2-ellipsis" style=`color: rgb(${colors});`></a></div>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
            <div class="grid-floating-cell-component-wrapper grid-cell-wrapper-component col-identifier-__group_title_dummy_column__">
               <div class="grid-cell-component-inner full" style="display: block;">
                  <div id="row-header-currentBoard-1819986031-1819986031_topics-notfloating-focus-group_title-" class="generic-group-header-name can-drag">
                     <span class="collapse-group-button">
                        <div data-testid="clickable" tabindex="0" role="button" class="clickable_1f03c608c2 collapse-group-toggle-component-new collapsable-icon-button collapsable-icon-button-no-color disableTextSelection_4036d2f679" style=`color: rgb(${colors});`>
                           <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" role="button" tabindex="0" aria-hidden="false" class="icon_1e99335b79 clickable_1f03c608c2" data-testid="icon">
                              <path d="M12.5303 9.46967L12 10L12.5303 10.5303C12.8232 10.2374 12.8232 9.76256 12.5303 9.46967ZM10.9393 10L7.46967 13.4697C7.17678 13.7626 7.17678 14.2374 7.46967 14.5303C7.76256 14.8232 8.23744 14.8232 8.53033 14.5303L12.5303 10.5303L12 10L12.5303 9.46967L8.53033 5.46967C8.23744 5.17678 7.76256 5.17678 7.46967 5.46967C7.17678 5.76256 7.17678 6.23744 7.46967 6.53033L10.9393 10Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path>
                           </svg>
                        </div>
                     </span>
                     <GroupHeader />
                  </div>
               </div>
               <div class="grid-cell-component-inner light" style="display: none;"></div>
            </div>
            <div class="grid-floating-cell-component-wrapper grid-cell-wrapper-component col-identifier-__group_right_component_dummy_column_">
               <div class="grid-cell-component-inner full" style="display: block;">
                  <div class="group-title-right-component-wrapper"></div>
               </div>
               <div class="grid-cell-component-inner light" style="display: none;"></div>
            </div>
         </div>
      </div>
      <RowHeader />
   </div>
</div>